# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

# Required only for the github extractor: GitHub personal access token.
# Create one at https://github.com/settings/tokens (read:org, public_repo scopes are sufficient).
GITHUB_TOKEN=your_github_token_here

# Fresh local SonarQube runs use the safe Compose defaults below. Uncomment
# these only for an existing or customized local SonarQube lifecycle.
# SONAR_ADMIN_DEFAULT_PASSWORD=admin
# SONAR_ADMIN_PASSWORD=Admin#Password12345
# SONAR_ADMIN_USER=admin
