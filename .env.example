# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.

# Required: GitHub personal access token for the github extractor.
# Create one at https://github.com/settings/tokens (read:org, public_repo scopes are sufficient).
GITHUB_TOKEN=your_github_token_here

# Bootstrap password for a fresh local SonarQube instance.
# Leave this as `admin` unless your local SonarQube has already been initialized
# with a different current admin password.
SONAR_ADMIN_DEFAULT_PASSWORD=admin

# Required: new SonarQube admin password that JOSSeph will set on first run.
# This is only used by the local Docker-based SonarQube started via docker compose.
# Choose any strong password; it does not need to match any external system.
SONAR_ADMIN_PASSWORD=choose_a_strong_password_here

# Optional: override SonarQube admin username (default: admin).
# SONAR_ADMIN_USER=admin
